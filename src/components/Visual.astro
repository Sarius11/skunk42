---
import type { Project } from '../lib/projects';

// What a program shows of itself: on a Home card (thumb) or as the project hero.
// Text-only work gets a title plate, so a book never looks like a guest.
interface Props {
  project: Project;
  variant: 'thumb' | 'hero';
}
const { project, variant } = Astro.props;
const { visual, heroImage, heroAlt, title, designation } = project.data;
const hero = variant === 'hero';
---
<div class:list={['vis', variant, `vis--${heroImage ? 'image' : visual}`]}>
  {heroImage ? (
    <img src={heroImage} alt={heroAlt ?? ''} loading={hero ? 'eager' : 'lazy'} />
  ) : visual === 'globe' ? (
    <>
      <canvas data-globe={hero ? 'sphere' : 'horizon'} aria-hidden="true"></canvas>
      {hero ? (
        <>
          <span class="mono hud tl">Live render</span>
          <span class="mono hud tr">Sub-satellite points · 5</span>
          <span class="mono hud bl" data-rotation>Rotation 000.0°</span>
        </>
      ) : <span class="mono hud tl">Render · live</span>}
    </>
  ) : visual === 'grid' ? (
    <>
      <div class="hatch" aria-hidden="true"></div>
      <span class="blip" style="left:38%;top:44%" aria-hidden="true"></span>
      <span class="blip" style="left:66%;top:62%;animation-delay:1.1s" aria-hidden="true"></span>
      <span class="mono hud tl">{hero ? 'Map · draft' : 'Map'}</span>
    </>
  ) : (
    <>
      <span class="mono hud tl">{designation} · Title plate</span>
      <span class="plate-t">{title}</span>
    </>
  )}
</div>

<style>
  .vis { position: relative; overflow: hidden; background: var(--surface-000); }
  .vis.thumb { height: 250px; border-bottom: 1px solid var(--hairline); }
  .vis.hero { height: clamp(300px, 46vw, 520px); border: 1px solid var(--hairline); background: var(--media-well); }
  .vis canvas, .vis img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .vis img { object-fit: cover; }
  .hud { position: absolute; }
  .tl { left: 14px; top: 12px; }
  .tr { right: 14px; top: 12px; text-align: right; }
  .bl { left: 14px; bottom: 12px; }
  .hatch {
    position: absolute; inset: 0; opacity: 0.6;
    background:
      repeating-linear-gradient(90deg, transparent 0 23px, var(--hairline) 23px 24px),
      repeating-linear-gradient(0deg, transparent 0 23px, var(--hairline) 23px 24px);
  }
  .blip { position: absolute; width: 8px; height: 8px; background: var(--signal); border-radius: var(--radius-round); animation: ping 2.4s infinite; }
  @keyframes ping {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 55%, transparent); }
    100% { box-shadow: 0 0 0 26px transparent; }
  }
  .vis--plate { background: var(--surface-100); }
  .plate-t {
    position: absolute; left: 20px; right: 20px; bottom: 18px;
    font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; line-height: 0.92; color: var(--ink);
    font-size: 44px; overflow-wrap: anywhere;
  }
  .hero .plate-t { left: 32px; bottom: 28px; font-size: clamp(48px, 9vw, 120px); }
</style>
