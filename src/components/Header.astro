---
import Wordmark from './Wordmark.astro';
import { pad2 } from '../lib/projects';

interface Props {
  active?: 'index' | 'about';
  litCount: number;
  /** The 404 page files itself as an anomaly and the telemetry says so. */
  anomaly?: boolean;
}
const { active, litCount, anomaly = false } = Astro.props;
const current = (page: Props['active']) => (active === page ? 'page' : undefined);
---
<header class="hdr" data-hdr>
  <div class="bar">
    <a href="/" class="brand" aria-label="Skunk42, home"><Wordmark size={17} /></a>
    <nav class="nav" aria-label="Main">
      <a href="/" aria-current={current('index')}>Home</a>
      <a href="/about/" aria-current={current('about')}>About</a>
    </nav>
    <div class="tele">
      {anomaly
        ? <span class="mono"><span class="lamp lamp--anom" aria-hidden="true"></span><b>1</b> anomaly</span>
        : <span class="mono"><span class="lamp lamp--live" aria-hidden="true"></span><b>{pad2(litCount)}</b> active</span>}
     <span class="mono clock">UTC <b data-utc>--:--:--</b></span>
      <button class="lights" type="button" data-lights aria-pressed="false"><i aria-hidden="true"></i>LIGHTS</button>
    </div>
    <button class="menubtn" type="button" data-menu aria-expanded="false" aria-controls="mobile-menu">
      <span data-menu-label>MENU</span><span class="burger" aria-hidden="true"></span>
    </button>
  </div>
</header>
<div class="overlay" id="mobile-menu" data-overlay>
  <nav aria-label="Main, mobile">
    <a href="/" aria-current={current('index')}>Index <span class="mono">01</span></a>
    <a href="/about/" aria-current={current('about')}>About <span class="mono">02</span></a>
  </nav>
  <div class="tele2">
    <span class="mono"><span class="lamp lamp--live" aria-hidden="true"></span><b>{pad2(litCount)}</b> active</span>
    <button class="lights" type="button" data-lights aria-pressed="false"><i aria-hidden="true"></i>LIGHTS</button>
  </div>
</div>

<style>
  .hdr {
    position: fixed; top: 0; left: 0; right: 0; z-index: 20;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s, border-color 0.3s;
  }
  .bar {
    max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter);
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 40px;
    height: var(--hdr-h); transition: height 0.3s var(--ease);
  }
  .hdr.compact { background: var(--glass); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-color: var(--hairline); }
  .hdr.compact .bar { height: 52px; }
  .brand { justify-self: start; }
  .nav { display: flex; gap: 30px; }
  .nav a {
    position: relative; padding: 6px 0;
    font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-muted); transition: color 0.2s;
  }
  .nav a:hover, .nav a[aria-current] { color: var(--ink); }
  .nav a[aria-current]::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--signal); }
  .tele { display: flex; align-items: center; gap: 22px; }
  .tele .mono { white-space: nowrap; }
  .lights {
    display: flex; gap: 8px; align-items: center; cursor: pointer;
    border: 1px solid var(--hairline); background: none; color: var(--ink); padding: 6px 10px;
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em;
  }
  .lights i { width: 18px; height: 9px; border: 1px solid var(--ink-muted); position: relative; display: inline-block; }
  .lights i::after { content: ""; position: absolute; top: 1px; left: 1px; width: 7px; height: 5px; background: var(--ink); transition: left 0.25s; }
  :global([data-theme="light"]) .lights i::after { left: 9px; }

  .menubtn {
    display: none; background: none; border: 0; cursor: pointer; padding: 8px 0;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; gap: 10px; align-items: center;
  }
  .burger { width: 18px; height: 9px; position: relative; }
  .burger::before, .burger::after {
    content: ""; position: absolute; left: 0; width: 18px; height: 1.5px; background: var(--ink);
    transition: transform 0.3s, top 0.3s;
  }
  .burger::before { top: 0; }
  .burger::after { top: 7px; }
  :global(html.menu-open) .burger::before { top: 4px; transform: rotate(45deg); }
  :global(html.menu-open) .burger::after { top: 4px; transform: rotate(-45deg); }

  .overlay {
    position: fixed; inset: var(--hdr-h) 0 0 0; z-index: 19; background: var(--surface-000);
    padding: 28px var(--gutter); display: none; flex-direction: column;
    transform: translateY(-100%); visibility: hidden; transition: transform 0.5s var(--ease), visibility 0.5s;
  }
  :global(html.menu-open) .overlay { transform: none; visibility: visible; }
  .overlay a {
    display: flex; justify-content: space-between; align-items: baseline; padding: 18px 0;
    border-bottom: 1px solid var(--hairline);
    font-weight: 800; font-size: 40px; line-height: 1; text-transform: uppercase; letter-spacing: 0.02em;
  }
  .overlay a[aria-current] { color: var(--ink); }
  .overlay a[aria-current] .mono { color: var(--signal); }
  .tele2 { margin-top: auto; padding-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }

  @media (max-width: 760px) {
    .nav, .tele { display: none; }
    .bar { grid-template-columns: auto auto; justify-content: space-between; }
    .hdr { background: var(--surface-000); border-color: var(--hairline); }
    .hdr.compact .bar { height: var(--hdr-h); }
    .menubtn { display: flex; }
    .overlay { display: flex; }
  }
</style>

<script>
  const root = document.documentElement;
  const hdr = document.querySelector<HTMLElement>('[data-hdr]');

  // Header compacts and frosts once the page scrolls.
  const onScroll = () => hdr?.classList.toggle('compact', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Live UTC clock.
  const clock = document.querySelector('[data-utc]');
  const p2 = (n: number) => String(n).padStart(2, '0');
  const tick = () => {
    const d = new Date();
    if (clock) clock.textContent = `${p2(d.getUTCHours())}:${p2(d.getUTCMinutes())}:${p2(d.getUTCSeconds())}`;
  };
  tick();
  setInterval(tick, 1000);

  // LIGHTS: dark/light switch that remembers the choice.
  const lights = document.querySelectorAll<HTMLButtonElement>('[data-lights]');
  const syncLights = () => lights.forEach((b) => b.setAttribute('aria-pressed', String(root.dataset.theme === 'light')));
  lights.forEach((b) =>
    b.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('s42-lights', next); } catch {}
      syncLights();
    }),
  );
  syncLights();

  // Mobile MENU: a full-screen list.
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
  const label = document.querySelector('[data-menu-label]');
  const setMenu = (open: boolean) => {
    root.classList.toggle('menu-open', open);
    menu?.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'CLOSE' : 'MENU';
  };
  menu?.addEventListener('click', () => setMenu(!root.classList.contains('menu-open')));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });
</script>
