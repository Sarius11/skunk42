---
import { statusOf, type StatusCode } from '../lib/status';

// The status block: official field names, unofficial values.
interface Row {
  label: string;
  value: string;
  /** Set dates and figures in mono. */
  mono?: boolean;
}
interface Props {
  code: StatusCode;
  /** Left side of the header: STATUS on a project, a designation elsewhere. */
  heading?: string;
  rows: Row[];
}
const { code, heading = 'Status', rows } = Astro.props;
const s = statusOf(code);
---
<section class="status panel" aria-label="Status">
  <div class="h">
    <span class="code">{heading.toUpperCase()}</span>
    <a class="mono state" href={`/status/#${s.code}`} title="See the status ladder"><span class={`lamp lamp--${s.lamp}`} aria-hidden="true"></span><b>{s.code} {s.name}</b></a>
  </div>
  <dl>
    {rows.map((r) => (
      <>
        <dt>{r.label}</dt>
        <dd class:list={{ m: r.mono }}>{r.value}</dd>
      </>
    ))}
  </dl>
</section>

<style>
  .h { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--hairline); }
  .h .code { font-size: 11px; }
  .state b { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color 0.2s; }
  .state:hover b { text-decoration-color: var(--signal); }
  dl { display: grid; grid-template-columns: 118px 1fr; gap: 11px 14px; padding: 16px; }
  dt {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-muted); padding-top: 2px;
  }
  dd { font-size: 14px; line-height: 1.45; }
  dd.m { font-family: var(--font-mono); font-size: 12.5px; }
  @media (max-width: 420px) { dl { grid-template-columns: 1fr; gap: 2px; } dd { margin-bottom: 10px; } }
</style>
