---
import Base from '../layouts/Base.astro';
import StatusBlock from '../components/StatusBlock.astro';

// The one place the 42 joke is allowed to be loud.
---
<Base title="404" description="Off by 362." anomaly>
  <section class="nf">
    <svg class="orb" viewBox="0 0 820 820" aria-hidden="true">
      <circle cx="410" cy="410" r="300" />
      <circle cx="410" cy="410" r="360" />
      <path class="trail" data-trail d="" />
      <circle class="sat" data-sat r="5" cx="410" cy="50" />
    </svg>
    <div class="wrap main">
      <div>
        <span class="num" data-num aria-hidden="true">404</span>
        <h1>Off by 362.</h1>
        <p class="lede">You asked for 404. The answer is 42. The page you wanted was either never sanctioned or has been quietly scrubbed.</p>
        <div class="back">
          <a class="btn" href="/">← Return to Index</a>
          <a class="btn btn--ghost" href="/about/">About</a>
        </div>
      </div>
      <StatusBlock
        code="S3"
        heading="S42-404 · Page"
        rows={[
          { label: 'Phase', value: 'Was cleared operational. Has since made other plans.' },
          { label: 'Last seen', value: '—', mono: true },
          { label: 'Known issues', value: 'Does not exist. Investigation ongoing.' },
        ]}
      />
    </div>
  </section>
</Base>

<style>
  .nf { position: relative; overflow: hidden; min-height: calc(100vh - var(--hdr-h) - 160px); display: flex; align-items: flex-end; padding: 80px 0 44px; }
  .orb { position: absolute; right: -220px; top: -120px; width: 820px; height: 820px; max-width: none; pointer-events: none; }
  .orb circle { fill: none; stroke: var(--hairline); }
  .orb .sat { fill: var(--signal); stroke: none; }
  .orb .trail { stroke: var(--signal); stroke-dasharray: 2 5; opacity: 0.6; fill: none; }
  .main { position: relative; display: grid; grid-template-columns: 1fr 360px; gap: 48px; align-items: end; }
  .num { font-family: var(--font-mono); font-size: clamp(110px, 18vw, 168px); line-height: 0.9; letter-spacing: -0.04em; display: block; font-variant-numeric: tabular-nums; }
  .num.done { color: var(--signal); }
  h1 { font-weight: 800; font-size: clamp(32px, 5vw, 44px); text-transform: uppercase; letter-spacing: 0.04em; line-height: 1; margin: 18px 0 14px; }
  .lede { font-size: 18px; line-height: 1.5; color: var(--ink-muted); max-width: 520px; }
  .back { display: flex; gap: 10px; margin-top: 26px; flex-wrap: wrap; }
  @media (max-width: 900px) {
    .main { grid-template-columns: 1fr; }
    .orb { right: -420px; top: -260px; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const p = (n: number) => String(n).padStart(2, '0');

  // File the page: Last seen is now.
  const d = new Date();
  const seen = [...document.querySelectorAll('.status dd')].find((dd) => dd.previousElementSibling?.textContent === 'Last seen');
  if (seen) seen.textContent = `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())} ${p(d.getUTCHours())}:${p(d.getUTCMinutes())} UTC`;

  // 404 counts down to 042, easing out.
  const num = document.querySelector<HTMLElement>('[data-num]');
  const finish = () => { if (num) { num.textContent = '042'; num.classList.add('done'); } };
  if (reduce) finish();
  else setTimeout(() => {
    let s = 0;
    const run = (t: number) => {
      if (!s) s = t;
      const k = Math.min(1, (t - s) / 1800), e = 1 - Math.pow(1 - k, 3);
      if (num) num.textContent = String(Math.round(404 - (404 - 42) * e)).padStart(3, '0');
      if (k < 1) requestAnimationFrame(run); else finish();
    };
    requestAnimationFrame(run);
  }, 500);

  // A satellite drifts off its orbit.
  const sat = document.querySelector('[data-sat]');
  const trail = document.querySelector('[data-trail]');
  if (sat && trail && !reduce) {
    const pts: string[] = [];
    const t0 = performance.now();
    const fly = (t: number) => {
      const k = (t - t0) / 1000, a = -Math.PI / 2 + k * 0.35, r = 360 + Math.max(0, k - 2) * 14;
      const x = 410 + r * Math.cos(a), y = 410 + r * Math.sin(a);
      sat.setAttribute('cx', x.toFixed(1));
      sat.setAttribute('cy', y.toFixed(1));
      pts.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
      if (pts.length > 120) pts.shift();
      trail.setAttribute('d', `M${pts.join(' L')}`);
      if (r < 900) requestAnimationFrame(fly);
    };
    requestAnimationFrame(fly);
  }
</script>
